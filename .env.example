# Database
POSTGRES_USER=jobparser
POSTGRES_PASSWORD=jobparser_secret
POSTGRES_DB=jobparser
DATABASE_URL=postgresql+asyncpg://jobparser:jobparser_secret@postgres:5432/jobparser

# Redis (queue / scheduler coordination)
REDIS_URL=redis://redis:6379/0

# App
LOG_LEVEL=INFO
SYNC_INTERVAL_MINUTES=60
TIMEZONE=Europe/Moscow
API_HOST=0.0.0.0
API_PORT=8000

# HH.ru official API (https://dev.hh.ru/)
HH_ACCESS_TOKEN=
# Must include a real contact email. Do NOT use example.com.
HH_USER_AGENT=JobParserLocal/1.0 (personal; your.email@mail.ru)
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=http://localhost:8000/api/v1/auth/hh/callback

# Source credentials (store secrets only in .env, never commit)
HABR_SESSION_COOKIE=
HIRIFY_API_KEY=
TALANTO_API_KEY=
GETMATCH_SESSION_COOKIE=
